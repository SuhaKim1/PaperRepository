        RowBox[{"qn", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
         "]"}]}], "]"}], "-", 
      RowBox[{"Un", "[", 
       RowBox[{
       "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]", ",", 
        RowBox[{"qs", "[", 
