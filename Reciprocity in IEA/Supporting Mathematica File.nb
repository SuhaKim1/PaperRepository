  "In[141]:=",ExpressionUUID->"42161092-ec04-4b69-9270-8d54bcfff70b"],

Cell[BoxData[
 RowBox[{"b", "-", 
  RowBox[{"c", " ", "qi"}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       FractionBox[
        RowBox[{"b", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "a"}], "-", "ks", "+", "n"}], ")"}]}], "c"], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "a", "-", "kr"}], ")"}], " ", "qrns"}], 
       "+", 
       RowBox[{"kr", " ", "qrs"}], "+", 
       RowBox[{"ks", " ", "qss"}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "n"}]], "-", "\[Eta]"}], ")"}]}]}]], "Output",\

 CellChangeTimes->{3.885735127882142*^9, 3.8857351698217583`*^9, 
  3.88573748723636*^9, 3.885737606554946*^9, 3.8857377733047*^9, 
