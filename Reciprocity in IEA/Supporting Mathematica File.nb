Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"qsg", "[", 
   RowBox[{"c_", ",", "n_", ",", "k_", ",", "a_", ",", "\[Eta]_"}], "]"}], 
  "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"c", "/", "n"}], ")"}], " ", "c", " ", "k", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"c", "/", "n"}], ")"}], " ", "n", " ", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"a", " ", "c"}], 
         RowBox[{"c", "-", 
          RowBox[{"c", "/", "n"}]}]], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"a", " ", "c"}], 
         RowBox[{"c", "-", 
          RowBox[{"c", "/", "n"}]}]], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          FractionBox[
           RowBox[{"a", " ", "c"}], 
           RowBox[{"c", "-", 
            RowBox[{"c", "/", "n"}]}]], ")"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"a", " ", "c"}], 
            RowBox[{"c", "-", 
             RowBox[{"c", "/", "n"}]}]], ")"}], " ", "\[Eta]"}], "+", 
         RowBox[{"c", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "k", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}], " ", 
             "\[Eta]"}]}], ")"}]}]}], ")"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["c", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}], " ", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"a", " ", "c"}], 
         RowBox[{"c", "-", 
          RowBox[{"c", "/", "n"}]}]], ")"}]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"a", " ", "c"}], 
          RowBox[{"c", "-", 
           RowBox[{"c", "/", "n"}]}]], ")"}], "2"]}]}], ")"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9187787528591757`*^9, 3.918778788624811*^9}, {
  3.918778819088129*^9, 3.91877883453156*^9}, {3.918779553337606*^9, 
