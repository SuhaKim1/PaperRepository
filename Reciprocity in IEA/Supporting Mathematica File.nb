  RowBox[{"qsp", "[", 
   RowBox[{"c_", ",", "n_", ",", "k_", ",", "a_", ",", "\[Eta]_"}], "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{
        RowBox[{
