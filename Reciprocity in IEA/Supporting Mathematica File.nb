Cell["Understanding Boundaries of Thresholds: [b/c , 1]", "Subsection",
 CellChangeTimes->{{3.9155735684100924`*^9, 3.9155735800950212`*^9}, {
  3.918291882434432*^9, 3.918291892131366*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"e0ca18aa-0bd6-4631-9f00-99ca1f69fe94"],

Cell[TextData[{
 "T_{U_{ns}} = ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "k"}], ")"}], " ", "k"}], "+", 
    RowBox[{"b", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "k"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "n"}], ")"}]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], "+", 
       RowBox[{
        SuperscriptBox["k", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "+", 
          RowBox[{"2", " ", "n"}]}], ")"}]}]}], ")"}]}]}], 
   RowBox[{"c", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "k"}], ")"}], " ", "k"}], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"]}], ")"}]}]]],
  CellChangeTimes->{3.905824993904853*^9, 3.9142765843516083`*^9, 
   3.9144632650038767`*^9, 3.9145393825291557`*^9, 3.914547329044198*^9, 
   3.914547366457102*^9, 3.914547626873011*^9, 3.914547863174308*^9, 
   3.9145484782432127`*^9, 3.915566461168017*^9, 3.91557149673989*^9, 
   3.915571953148753*^9},
  FontSize->18,ExpressionUUID->"78df9d28-9a99-4b45-9d79-fe1f6f462113"],
 ". "
}], "Text",
 CellChangeTimes->{{3.915573815903873*^9, 3.915573830967654*^9}, {
   3.91557393161544*^9, 3.915573960515523*^9}, {3.918291926501052*^9, 
   3.9182919265792503`*^9}, 3.918292113060586*^9},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"89b0851d-f98b-406a-8e5e-b91924074cec"],

Cell["\<\
For T_{U_{ns}} < 1, we found the following equivalent condition in the paper: \
(n-1)^3 - k^2 (2n-3) + k(n-2) > 0
Numerically analyzing it shows that the condition does not hold for \
sufficiently high k relative to n:\
\>", "Text",
 CellChangeTimes->{{3.9155740331133137`*^9, 3.9155740898020973`*^9}, {
   3.915577474086815*^9, 3.9155775039662323`*^9}, {3.918292131128134*^9, 
   3.918292168117519*^9}, {3.9182922354830093`*^9, 3.9182923002945023`*^9}, {
   3.9182928161657124`*^9, 3.918292879322914*^9}, {3.9182929740293417`*^9, 
   3.918292980055982*^9}, 3.918432439099032*^9},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"81488235-746b-481c-b0c5-05e66811a107"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cond", "[", 
   RowBox[{"k_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}], "^", "3"}], "-", 
   RowBox[{
    RowBox[{"k", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "n"}], "-", "3"}], ")"}]}], "+", 
   RowBox[{"k", 
    RowBox[{"(", 
     RowBox[{"n", "-", "2"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.918292735291419*^9, 3.918292761265459*^9}},
 FontFamily->"Courier",
 FontWeight->"Regular",
 CellLabel->"In[65]:=",ExpressionUUID->"f9491049-bb1f-43e2-8617-8a13114a433e"],

