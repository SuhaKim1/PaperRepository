  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "-", 
      RowBox[{"c", " ", "qi"}], "+", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           FractionBox[
            RowBox[{"b", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "a"}], "+", "n"}], ")"}]}], "c"], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", "qi"}]}], 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}]], "-", "\[Eta]"}], ")"}]}]}], "==", 
     "0"}], ",", "qi"}], "]"}], "]"}]], "Input",
 FontFamily->"Courier",
