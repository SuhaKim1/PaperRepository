Cell[BoxData[
 RowBox[{
  RowBox[{"derUsqna", "[", 
   RowBox[{"b_", ",", "c_", ",", "n_", ",", "k_", ",", "a_", ",", "\[Eta]_"}],
    "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "k"}], "+", "n"}], ")"}]}], "+", 
      FractionBox[
       RowBox[{"a", " ", "c", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "k"}], "+", "n"}], ")"}], " ", 
        RowBox[{"(", 
