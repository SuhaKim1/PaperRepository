         "]"}]}], "]"}]}], "==", "0"}], ",", "k"}], "]"}], "]"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"110e72b8-9cfe-4d61-9c7e-c23b60810e84"],

