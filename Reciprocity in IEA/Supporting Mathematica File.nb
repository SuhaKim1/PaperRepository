Cell[BoxData[
 RowBox[{
  RowBox[{"qrnsf", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "ks_", ",", " ", "kr_", ",", 
    "\[Alpha]_", ",", "\[Eta]_"}], "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"qrns", "[", 
    RowBox[{
    "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",", 
     "\[Alpha]", ",", "\[Eta]", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "n"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "c"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", "\[Alpha]"}], 
         ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"b", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["c", "3"], " ", 
              RowBox[{"(", 
               RowBox[{"kr", "+", "ks"}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"]}], "-", 
             RowBox[{"kr", " ", 
              RowBox[{"(", 
               RowBox[{"a", "+", "ks", "-", "n"}], ")"}], " ", 
              SuperscriptBox["\[Alpha]", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n", "+", "\[Alpha]"}], ")"}]}], "+", 
             RowBox[{
              SuperscriptBox["c", "2"], " ", 
              RowBox[{"(", 
               RowBox[{"kr", "+", "ks"}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n", "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "a", "-", 
                   RowBox[{"2", " ", "kr"}]}], ")"}], " ", "\[Alpha]"}]}], 
               ")"}]}], "+", 
             RowBox[{"c", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "2"}], "+", "kr"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"kr", "+", "ks"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
                RowBox[{"2", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "a", "-", "kr"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"kr", "+", "ks"}], ")"}], " ", "\[Alpha]"}], "+", 
                RowBox[{"kr", " ", "n", " ", "\[Alpha]"}]}], ")"}]}]}], 
            ")"}]}], "+", 
          RowBox[{"c", " ", "kr", " ", "\[Alpha]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["c", "2"], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}], "-", 
             RowBox[{"c", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n", "-", 
                RowBox[{"a", " ", "\[Alpha]"}], "+", 
                RowBox[{"2", " ", "kr", " ", "\[Alpha]"}], "+", "\[Eta]", "-", 
                RowBox[{"n", " ", "\[Eta]"}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "a", "-", 
                   RowBox[{"2", " ", "kr"}], "+", "n"}], ")"}], " ", 
                 "\[Alpha]", " ", "\[Eta]"}]}], ")"}]}], "+", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n", "+", "\[Alpha]", "-", 
                RowBox[{"a", " ", "\[Alpha]"}], "+", 
                RowBox[{"kr", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}], "+", 
                RowBox[{"a", " ", "\[Alpha]", " ", "\[Eta]"}], "-", 
                RowBox[{"n", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "n", "+", "\[Alpha]"}], ")"}], 
                 " ", "\[Eta]"}]}], ")"}]}]}], ")"}]}]}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"c", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "kr"}], " ", "ks", " ", 
           SuperscriptBox["\[Alpha]", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "c"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", "\[Alpha]"}], 
            ")"}]}], "+", 
          RowBox[{"c", " ", "kr", " ", "ks", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
