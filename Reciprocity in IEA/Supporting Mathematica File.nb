Cell[BoxData["0.9000000000000148`"], "Output",
 CellChangeTimes->{3.905903853580532*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"70c68afa-ead0-4740-b9c8-01d90f19f2a3"]
}, Open  ]],

Cell[CellGroupData[{

