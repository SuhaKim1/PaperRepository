 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"ef0f9a48-d4f3-4189-a191-bd482ece0776"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "^", "2"}], "+", 
    RowBox[{"k", " ", "n", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "k"}], "-", "5"}], ")"}]}], "+", "n", "+", 
    RowBox[{"k", 
     RowBox[{"(", 
      RowBox[{"8", "-", 
       RowBox[{"3", "k"}]}], ")"}]}], "-", "4"}], ">", 
   RowBox[{
    RowBox[{"n", 
     RowBox[{"(", 
      RowBox[{"n", "-", "2"}], ")"}]}], "+", 
    RowBox[{"k", 
     RowBox[{"(", 
      RowBox[{"k", "-", "3"}], ")"}]}], "+", "3", "-", 
    RowBox[{"n", 
     RowBox[{"(", 
      RowBox[{"k", "-", "2"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"k", "-", "1"}], ")"}]}]}]}], "]"}]], "Input",
