   ".0307", ",", "1.01", ",", "10", ",", "9", ",", "0.5", ",", "0.8"}], "]"}],
   "]"}]], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"08a62072-d253-4932-bb08-34f3064be278"],

Cell[BoxData[
 RowBox[{"-", "0.5207738392411391`"}]], "Output",
 CellChangeTimes->{3.905903980143495*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"96b26aac-3108-4998-a4a2-03f6f35c4356"]
}, Open  ]],

