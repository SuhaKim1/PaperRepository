   ".0309", ",", "1.01", ",", "10", ",", "10", ",", "0.5", ",", "0.8"}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"275b9107-fd8d-4fb9-bbd2-53398ba6b080"],

Cell[BoxData["0.12284671532847481`"], "Output",
 CellChangeTimes->{3.9059038580254383`*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"5c0fbecb-05db-4d94-b8c6-46c889b34771"]
}, Open  ]],

Cell["\<\
But we need to make sure that effort levels are non-negative at k = N-1:\
\>", "Text",
 CellChangeTimes->{{3.905903909977435*^9, 
  3.9059040113750343`*^9}},ExpressionUUID->"39c9229d-bd59-4678-ab6b-\
3cd04ef61406"],

