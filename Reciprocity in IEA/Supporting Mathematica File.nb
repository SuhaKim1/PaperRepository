 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"a8e6102e-760a-4f9f-b94b-63de30057f17"],

Cell["Let\[CloseCurlyQuote]s start with the self-interested signatories \
problem.", "Text",
 CellChangeTimes->{{3.885735494568326*^9, 3.885735510000313*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"c4af2abe-74f6-46c1-9145-470152a73534"],

Cell[BoxData[
 RowBox[{
  RowBox[{"usig", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "ks_", ",", " ", "kr_", ",", 
    "\[Alpha]_", ",", "\[Eta]_", ",", "qss_", ",", "qrs_"}], "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ks", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"b", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "a", "-", "ks"}], ")"}], 
           FractionBox["b", "c"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "-", "kr"}], ")"}], 
           RowBox[{"qrns", "[", 
            RowBox[{
            "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",",
              "\[Alpha]", ",", "\[Eta]", ",", "qss", ",", "qrs"}], "]"}]}], 
          "+", 
          RowBox[{"ks", "*", "qss"}], "+", 
          RowBox[{"kr", "*", "qrs"}]}], ")"}]}], "-", 
       RowBox[{
        FractionBox["c", "2"], 
        SuperscriptBox["qss", "2"]}]}], ")"}]}], "+", 
    RowBox[{"kr", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"b", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "a", "-", "ks"}], ")"}], 
           FractionBox["b", "c"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "-", "kr"}], ")"}], 
           RowBox[{"qrns", "[", 
            RowBox[{
            "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",",
              "\[Alpha]", ",", "\[Eta]", ",", "qss", ",", "qrs"}], "]"}]}], 
          "+", 
          RowBox[{"ks", "*", "qss"}], "+", 
          RowBox[{"kr", "*", "qrs"}]}], ")"}]}], "-", 
       RowBox[{
        FractionBox["c", "2"], 
        SuperscriptBox["qrs", "2"]}], "-", 
       RowBox[{
        RowBox[{"+", "\[Alpha]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"n", "-", "1"}]], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "a", "-", "ks"}], ")"}], 
              FractionBox["b", "c"]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", "kr"}], ")"}], 
              RowBox[{"qrns", "[", 
               RowBox[{
               "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", 
                ",", "\[Alpha]", ",", "\[Eta]", ",", "qss", ",", "qrs"}], 
               "]"}]}], "+", 
             RowBox[{"ks", "*", "qss"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"kr", "-", "1"}], ")"}], "qrs"}]}], ")"}]}], "-", 
          "\[Eta]"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"qrs", "+", "1", "-", "\[Eta]"}], ")"}]}]}], ")"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.885737272287116*^9, 3.8857373312676563`*^9}, {
   3.885737550341316*^9, 3.8857375745276823`*^9}, {3.88573767970442*^9, 
   3.885737679878168*^9}, {3.885737802634954*^9, 3.885737835312009*^9}, 
   3.885738164189239*^9, {3.885738208745994*^9, 3.8857383521756983`*^9}, {
   3.885739064456056*^9, 3.885739071368294*^9}, {3.88573918423704*^9, 
   3.885739187088333*^9}, {3.885739222798071*^9, 3.885739237704422*^9}},
