Cell[CellGroupData[{

Cell["Reciprocal Non-signatories", "Subsubsection",
 CellChangeTimes->{3.906084860866453*^9},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"8760d101-6099-4456-b80a-85cf16fcf4eb"],

Cell["\<\
Remember that self-interested non-signatories have dominant strategy of \
exerting b/c.
kr and ks refer to the number of reciprocal and self-interested signatories.\
\>", "Text",
 CellChangeTimes->{{3.885734779493373*^9, 3.8857348047546597`*^9}, {
  3.90608515656894*^9, 3.906085180542835*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"5174941d-4e5f-4fdb-9e77-a39241d7cccd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"urnsi", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "ks_", ",", " ", "kr_", ",", 
    "\[Alpha]_", ",", "\[Eta]_", ",", "qi_", ",", "qss_", ",", "qrs_", ",", 
    "qrns_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"b", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "a", "-", "ks"}], ")"}], 
       FractionBox["b", "c"]}], "+", 
      RowBox[{"ks", "*", "qss"}], "+", 
      RowBox[{"kr", "*", "qrs"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "-", "kr", "-", "1"}], ")"}], "qrns"}], "+", "qi"}], 
     ")"}]}], "-", 
   RowBox[{
    FractionBox["c", "2"], 
    SuperscriptBox["qi", "2"]}], "+", 
   RowBox[{"\[Alpha]", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "-", "a", "-", "ks"}], ")"}], 
         FractionBox["b", "c"]}], "+", 
        RowBox[{"ks", "*", "qss"}], "+", 
        RowBox[{"kr", "*", "qrs"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "-", "kr", "-", "1"}], ")"}], "qrns"}]}], 
       RowBox[{"n", "-", "1"}]], "-", "\[Eta]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"qi", "+", "1", "-", "\[Eta]"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.8857348392571774`*^9, 3.885734873077635*^9}, {
  3.885734907218905*^9, 3.8857349496196404`*^9}, {3.885734983207725*^9, 
  3.885735083842091*^9}, {3.885737471359858*^9, 3.88573748061204*^9}, {
  3.885737597002514*^9, 3.885737600349085*^9}, {3.8857377584364643`*^9, 
  3.885737761811266*^9}},
 FontFamily->"Courier",
 FontWeight->"Regular",
 CellLabel->
  "In[140]:=",ExpressionUUID->"fcd88a2d-8d50-48c5-8ff8-b54338aa4d02"],

Cell["Taking derivative wrt qi yields:", "Text",
 CellChangeTimes->{3.8857351073695803`*^9},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"103f87cd-cc6e-4989-a4e5-d845efe5915e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"urnsi", "[", 
    RowBox[{
    "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",", 
     "\[Alpha]", ",", "\[Eta]", ",", "qi", ",", "qss", ",", "qrs", ",", 
     "qrns"}], "]"}], ",", "qi"}], "]"}]], "Input",
