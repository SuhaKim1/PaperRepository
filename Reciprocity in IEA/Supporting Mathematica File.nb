Cell[TextData[{
 "The latter is negative. So, they are equal at k = 1 - ",
 Cell[BoxData[
  FractionBox["\[Alpha]", "c"]],
  CellChangeTimes->{3.905481136474853*^9},ExpressionUUID->
  "5f03c146-8bfc-4925-9b76-4959f31c2b70"],
 ". ",
 StyleBox["This proves the part 4 and it is useful to prove the parts 3 and \
