}, Open  ]],

Cell["\<\
This shows that at these parameters, both qs and qn are considered negative \
when evaluating Un(N-1). So, making sure that the lowest value they can take \
is zero yields:\
\>", "Text",
 CellChangeTimes->{
  3.905904007014449*^9},ExpressionUUID->"39445106-74a8-4e65-a687-\
cb8352f6defc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Us", "[", 
    RowBox[{
    ".0307", ",", "1.01", ",", "10", ",", "10", ",", "0.5", ",", "0.8", ",", 
     RowBox[{"qs", "[", 
      RowBox[{
      ".0307", ",", "1.01", ",", "10", ",", "10", ",", "0.5", ",", "0.8"}], 
      "]"}], ",", 
     RowBox[{"qn", "[", 
      RowBox[{
      ".0307", ",", "1.01", ",", "10", ",", "10", ",", "0.5", ",", "0.8"}], 
      "]"}]}], "]"}], "-", 
   RowBox[{"Un", "[", 
    RowBox[{
    ".0307", ",", "1.01", ",", "10", ",", "9", ",", "0.5", ",", "0.8", ",", 
     "0", ",", "0"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"112cb59d-03b6-40f2-8d4c-b1ba212dc8a7"],

Cell[BoxData["0.0024499999999999245`"], "Output",
 CellChangeTimes->{3.905904021520455*^9},
 CellLabel->"Out[95]=",ExpressionUUID->"a5ca8a22-b545-49d1-bdcd-9b16f3638bd5"]
}, Open  ]],

Cell["\<\
Therefore, the condition U_s(N) \[GreaterEqual] U_n(N-1) continues to hold \
when we make sure that effort levels are in [0,1) and found that there is a \
stable grand coalition with the optimal effort levels in the interior of \
their domains.\
\>", "Text",
 CellChangeTimes->{{3.905904035853836*^9, 
  3.90590413047799*^9}},ExpressionUUID->"a4071db9-fb9f-4054-8b3f-\
3e585a89c158"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Strategic Use of Eta", "Section",
 CellChangeTimes->{{3.905908516367024*^9, 
  3.90590852031535*^9}},ExpressionUUID->"420cce9a-ce34-416b-9344-\
5320ed28033c"],

Cell["\<\
In the paper, we assume N-1 countries set their truthful expectations \
\[OpenCurlyDoubleQuote]eta\[CloseCurlyDoubleQuote] while one country is \
strategically setting its expectations. Thus, we have a case of heterogenous \
expectations. In this supporting file, we first solve the game with possibly \
two types of countries different in their expectations, which we call them \
low and high expectations here. Then, assume that there is only one country \
of one of the types.\
\>", "Text",
 CellChangeTimes->{{3.905908534198297*^9, 3.90590870904624*^9}, {
  3.9059087585463753`*^9, 
  3.905908769650374*^9}},ExpressionUUID->"f88332c1-89a5-415f-953b-\
11353358fd04"],

Cell["\<\
Let the number of countries be N, low types by l and, thus, the high types be \
N-l. Among k signatories, k_L and k_H be the number of low and high types,  \
respectively.
The utility under symmetry, the equation (7): U(b, c, \[Alpha], \[Eta], N, \
q_i, Q_-i) = b(Q_-i + qi) - (c/2)(qi)^2 +\[Alpha](Q_-i/(N -1) - \[Eta])(q_i \
+1 - \[Eta])
Let\[CloseCurlyQuote]s solve the non-cooperative game.\
\>", "Text",
 CellChangeTimes->{{3.9059087251172657`*^9, 3.905908731130632*^9}, {
  3.905908887056362*^9, 
  3.905908898385016*^9}},ExpressionUUID->"ca50dbc9-90a3-4340-9e02-\
1f385a716e97"],

Cell["The utility function of a country with LOW EXPECTATIONS is:", "Text",
 CellChangeTimes->{{3.905908908538376*^9, 
  3.90590891106348*^9}},ExpressionUUID->"0de64556-4c25-4962-bacf-\
bad1b2931440"],

Cell[BoxData[
 RowBox[{
  RowBox[{"utilitynoncooplowetai", "[", 
   RowBox[{
   "b_", ",", " ", "c_", ",", " ", "\[Alpha]_", ",", " ", "\[Eta]L_", ",", 
    "\[Eta]H_", ",", " ", "n_", ",", "l_", ",", " ", "qLn_", ",", "qHn_", ",",
     "qLi_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"b", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "l"}], ")"}], "qHn"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "-", "1"}], ")"}], "qLn"}], "+", "qLi"}], ")"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"c", "/", "2"}], ")"}], 
    RowBox[{"qLi", "^", "2"}]}], "+", 
   RowBox[{"\[Alpha]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "l"}], ")"}], "qHn"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "1"}], ")"}], "qLn"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}]}], "-", "\[Eta]L"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"qLi", "+", "1", "-", "\[Eta]H"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{3.9059089213690643`*^9},
 CellLabel->"In[96]:=",ExpressionUUID->"4d33752a-204c-4d35-a037-205c746ac588"],

Cell["\<\
The best-response function of country i with LOW EXPECTATION:\
\>", "Text",
 CellChangeTimes->{
  3.905908933704042*^9},ExpressionUUID->"f0414dbc-6fd6-42d9-8430-\
1d50a4254536"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"utilitynoncooplowetai", "[", 
        RowBox[{
        "b", ",", " ", "c", ",", " ", "\[Alpha]", ",", " ", "\[Eta]L", ",", 
         "\[Eta]H", ",", " ", "n", ",", "l", ",", " ", "qLn", ",", "qHn", ",",
          "qLi"}], "]"}], ",", "qLi"}], "]"}], "==", "0"}], ",", "qLi"}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"cab84adb-1ca4-4a4d-b496-9c0730ce8095"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"qLi", "\[Rule]", 
    FractionBox[
     RowBox[{"b", "+", 
      FractionBox[
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"n", " ", "qHn"}], "-", "qLn", "+", 
          RowBox[{"l", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "qHn"}], "+", "qLn"}], ")"}]}], "+", "\[Eta]L", "-", 
          RowBox[{"n", " ", "\[Eta]L"}]}], ")"}]}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]]}], "c"]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9059089413884163`*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"788fb2f8-ee9a-4ada-8788-e6fcc2d63427"]
}, Open  ]],

Cell["\<\
In equilibrium, all identical types exert the same effort level:\
\>", "Text",
 CellChangeTimes->{
  3.905908950703084*^9},ExpressionUUID->"585f092b-8713-44e6-b810-\
57f37667aa21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"qLn", "==", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"n", " ", "qHn"}], " ", "-", " ", "qLn", " ", "+", " ", 
             RowBox[{"l", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "qHn"}], " ", "+", " ", "qLn"}], ")"}]}], " ", 
             "+", " ", "\[Eta]L", " ", "-", 
             RowBox[{"n", " ", "\[Eta]L"}]}], ")"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "+", " ", "n"}], ")"}]}]}], ")"}], "/", 
      "c"}]}], ",", "qLn"}], "]"}], "]"}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"0ffffdb1-e95f-4997-93cf-abd310dd5635"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"qLn", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "l"}], " ", "qHn"}], "+", 
         RowBox[{"n", " ", "qHn"}], "+", "\[Eta]L", "-", 
         RowBox[{"n", " ", "\[Eta]L"}]}], ")"}]}]}], 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", "\[Alpha]", "-", 
      RowBox[{"l", " ", "\[Alpha]"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9059089567968616`*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"72c2295b-44e4-4e87-b583-d5acbcd54551"]
}, Open  ]],

Cell["The utility function of a country with HIGH EXPECTATIONS is:", "Text",
 CellChangeTimes->{{3.9059089647767973`*^9, 
  3.905908966639072*^9}},ExpressionUUID->"a771258d-0adc-4d01-802e-\
f0521aa6feff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"utilitynoncoophighetai", "[", 
   RowBox[{
   "b_", ",", " ", "c_", ",", " ", "\[Alpha]_", ",", "\[Eta]L_", ",", " ", 
    "\[Eta]H_", ",", " ", "n_", ",", "l_", ",", " ", "qLn_", ",", "qHn_", ",",
     "qHi_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"b", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
