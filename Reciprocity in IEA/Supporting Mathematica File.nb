    "2"]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "k", "-", "n"}], ")"}], " ", "\[Alpha]"}]}], ")"}], 
    "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["c", "2"]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}], " ", "\[Alpha]"}], 
      "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Alpha]", "2"]}]}], ")"}], "2"]}]]], "Output",
 CellChangeTimes->{3.905480268120914*^9, 3.905644683081086*^9, 
