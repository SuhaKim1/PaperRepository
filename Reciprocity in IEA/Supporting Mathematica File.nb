Cell[TextData[{
 "are used in the ",
 StyleBox["proof of parts (1 and 2).\n",
  FontFamily->"Source Code Pro",
  FontSize->13,
  FontWeight->"Bold"],
 StyleBox["At what k signatory and non-signatory indirect welfare are equal?",
  
  FontFamily->"Source Code Pro",
  FontSize->13,
  FontWeight->"Regular"]
}], "Text",
 CellChangeTimes->{{3.9054803544635773`*^9, 3.905480384771473*^9}, {
