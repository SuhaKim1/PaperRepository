Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"diff", "[", 
   RowBox[{"b_", ",", "c_", ",", "k_", ",", "n_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "k"}], ")"}]}], "+", 
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{"n", "+", 
         RowBox[{"k", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}]}], ")"}]}]}], 
     RowBox[{"c", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}]}]], "-", 
    FractionBox[
     RowBox[{"b", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "k"}], ")"}], " ", "k"}], "+", "n"}], 
       ")"}]}], 
     RowBox[{"c", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}]}]]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.914286082160576*^9, 3.9142860954961767`*^9}, {
