Cell[CellGroupData[{

Cell["Heterogeneity: Self-Interested and Reciprocal Countries", "Section",
 CellChangeTimes->{{3.905990076179335*^9, 3.905990083896616*^9}, {
  3.906083440741189*^9, 
  3.906083444948234*^9}},ExpressionUUID->"2f9b2942-88c1-4ef8-a9bd-\
4450d64e4986"],

Cell["\<\
There are A<N reciprocal countries with \[Alpha]_i = \[Alpha] and N-A \
self-interested countries with \[Alpha]_i = 0. \
\>", "Text",
 CellChangeTimes->{
  3.905990722928595*^9},ExpressionUUID->"4caa9c8d-99e0-4983-876b-\
52bbe3e97769"],

Cell[CellGroupData[{

Cell["Non-Cooperative Game - Proposition 5", "Subsection",
 CellChangeTimes->{
  3.905990732525214*^9, {3.905992407864274*^9, 
   3.905992411756193*^9}},ExpressionUUID->"5e4b897e-2ff1-421b-8fa8-\
4b1182da44fa"],

Cell["\<\
Self-interested countries have a dominant strategy to exert b/c. Let\
\[CloseCurlyQuote]s find out about the reciprocal Nash efforts. To do that, \
let\[CloseCurlyQuote]s write the utility function.\
\>", "Text",
 CellChangeTimes->{
  3.9059907389178343`*^9},ExpressionUUID->"82469d8f-943a-400b-bbd0-\
ecc8bb1b1c95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ui", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "\[Alpha]_", ",", "\[Eta]_", 
    ",", "qi_", ",", "qj_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"b", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "a"}], ")"}], 
       FractionBox["b", "c"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}], "qj"}], "+", "qi"}], ")"}]}], "-", 
   RowBox[{
    FractionBox["c", "2"], 
    SuperscriptBox["qi", "2"]}], "+", 
   RowBox[{"\[Alpha]", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "-", "a"}], ")"}], 
         FractionBox["b", "c"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "-", "1"}], ")"}], "qj"}]}], 
       RowBox[{"n", "-", "1"}]], "-", "\[Eta]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"qi", "+", "1", "-", "\[Eta]"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{3.905990750733724*^9},
 CellLabel->
  "In[176]:=",ExpressionUUID->"3d973aa7-417f-4877-9e70-536686622412"],

Cell["\<\
Taking derivative wrt qi and solving for qi yields the Nash efforts of the \
reciprocal countries:\
\>", "Text",
 CellChangeTimes->{{3.9059907589703093`*^9, 
  3.905990807264606*^9}},ExpressionUUID->"d80b078c-ca1d-4295-9a26-\
38a789bb6337"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"ui", "[", 
    RowBox[{
    "b", ",", "c", ",", "n", ",", "a", ",", "\[Alpha]", ",", "\[Eta]", ",", 
     "qi", ",", "qj"}], "]"}], ",", "qi"}], "]"}]], "Input",
 CellLabel->
