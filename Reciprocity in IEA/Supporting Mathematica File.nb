                RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}]}], ")"}]}], 
          ")"}]}], ">", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
