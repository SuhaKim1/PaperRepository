 CellLabel->
  "Out[190]=",ExpressionUUID->"87c4051b-addb-41b9-b9c7-c92daa5a5932"]
}, Open  ]],

Cell["Using symmetry and solving for qrns yields the result:", "Text",
 CellChangeTimes->{{3.885735361441725*^9, 
  3.8857353760953712`*^9}},ExpressionUUID->"0c62c1f3-8782-42c5-b85b-\
921d872df247"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "-", 
      RowBox[{"c", " ", "qrns"}], "+", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           FractionBox[
            RowBox[{"b", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "a"}], "-", "ks", "+", "n"}], ")"}]}], "c"], "+", 
           
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "-", "kr", "-", "1"}], ")"}], " ", "qrns"}], "+", 
           RowBox[{"kr", " ", "qrs"}], "+", 
           RowBox[{"ks", " ", "qss"}]}], 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}]], "-", "\[Eta]"}], ")"}]}]}], 
     "\[Equal]", "qrns"}], ",", "qrns"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.885735201646077*^9, 3.88573524847367*^9}, {
   3.885735317086316*^9, 3.885735321222067*^9}, {3.8857375133662853`*^9, 
   3.885737517788723*^9}, {3.8857376393619947`*^9, 3.8857376394244347`*^9}, 
