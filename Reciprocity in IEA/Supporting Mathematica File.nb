Cell[BoxData[
 RowBox[{
  RowBox[{"qrsnob", "[", 
   RowBox[{
   "c_", ",", "n_", ",", "a_", ",", "ks_", ",", " ", "kr_", ",", "\[Alpha]_", 
    ",", "\[Eta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "/", "n"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "c"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{"kr", "+", "ks"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "c"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "ks"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"kr", "+", "ks"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"ks", "+", 
              RowBox[{"c", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "3"}], "-", "kr", "+", "ks"}], ")"}]}]}], 
             ")"}]}], "+", 
           RowBox[{"a", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{"c", " ", 
               RowBox[{"(", 
                RowBox[{"kr", "+", "ks"}], ")"}]}]}], ")"}]}], "+", "n", "+", 
           
           RowBox[{"c", " ", "n"}]}], ")"}], " ", "\[Alpha]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "+", 
           RowBox[{"ks", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "+", "kr", "+", 
              RowBox[{"2", " ", "ks"}]}], ")"}]}], "+", 
           RowBox[{"a", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "-", "kr", "+", "ks", "+", 
              RowBox[{"c", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{"2", " ", "kr"}], "+", 
                 RowBox[{"2", " ", "ks"}], "-", "n"}], ")"}]}], "-", "n"}], 
             ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "+", "kr"}], ")"}], " ", "n"}], "+", 
           RowBox[{"c", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"ks", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "3"}], "+", 
                 RowBox[{"2", " ", "ks"}]}], ")"}]}], "+", 
              RowBox[{"2", " ", "n"}], "+", 
              RowBox[{"kr", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "2"}], "-", 
                 RowBox[{"2", " ", "kr"}], "+", "n"}], ")"}]}]}], ")"}]}]}], 
          ")"}], " ", 
         SuperscriptBox["\[Alpha]", "2"]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "-", "ks", "+", 
           SuperscriptBox["ks", "2"], "+", "n", "+", 
           RowBox[{"kr", " ", "n"}], "-", 
           RowBox[{"a", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "kr", "-", "ks", "+", "n"}], ")"}]}]}], ")"}], 
         " ", 
         SuperscriptBox["\[Alpha]", "3"]}]}], ")"}]}], "+", 
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "kr"}], " ", "ks", " ", "\[Alpha]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n", "+", "\[Alpha]"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}], "+", 
        RowBox[{
         SuperscriptBox["c", "3"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "kr", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "+", "kr", "+", "n"}], ")"}], " ", 
            "\[Eta]"}]}], ")"}]}], "+", 
        RowBox[{
         SuperscriptBox["c", "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{"2", " ", "kr"}], "+", 
           RowBox[{"2", " ", "n"}], "-", 
           RowBox[{"2", " ", "kr", " ", "n"}], "+", 
           RowBox[{"2", " ", "\[Alpha]"}], "-", 
           RowBox[{"2", " ", "a", " ", "\[Alpha]"}], "+", 
           RowBox[{"a", " ", "kr", " ", "\[Alpha]"}], "-", 
           RowBox[{
            SuperscriptBox["kr", "2"], " ", "\[Alpha]"}], "+", 
           RowBox[{"kr", " ", "ks", " ", "\[Alpha]"}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "+", "kr", "+", "n"}], ")"}], " ", 
            "\[Eta]"}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"4", "+", "kr", "-", 
              RowBox[{"2", " ", "n"}], "+", 
              RowBox[{"a", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "3"}], "+", "kr", "+", "n"}], ")"}]}], "-", 
              RowBox[{"kr", " ", 
               RowBox[{"(", 
                RowBox[{"kr", "-", "ks", "+", "n"}], ")"}]}]}], ")"}], " ", 
            "\[Alpha]", " ", "\[Eta]"}]}], ")"}]}], "+", 
        RowBox[{"c", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["kr", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "\[Alpha]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n", "+", "\[Alpha]", "-", 
              RowBox[{"a", " ", "\[Alpha]"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n", "+", "\[Alpha]", "-", 
              RowBox[{"a", " ", "\[Alpha]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"2", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "2"}], "+", "a"}], ")"}], " ", "\[Alpha]"}], 
                 "+", 
                 RowBox[{"n", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "3"}], "+", "n", "+", "\[Alpha]"}], 
                   ")"}]}]}], ")"}], " ", "\[Eta]"}]}], ")"}]}], "+", 
           RowBox[{"kr", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Eta]", "+", 
              RowBox[{
               SuperscriptBox["n", "2"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "\[Eta]", "+", 
                 RowBox[{"\[Alpha]", " ", "\[Eta]"}]}], ")"}]}], "+", 
              RowBox[{"n", " ", 
               RowBox[{"(", 
                RowBox[{"2", "+", 
                 RowBox[{"a", " ", "\[Alpha]"}], "+", 
                 RowBox[{"2", " ", "ks", " ", "\[Alpha]"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "2"}], "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "+", "a", "+", 
                    RowBox[{"2", " ", "ks"}]}], ")"}], " ", "\[Alpha]"}], "+", 
                    SuperscriptBox["\[Alpha]", "2"]}], ")"}], " ", 
                  "\[Eta]"}]}], ")"}]}], "+", 
              RowBox[{"\[Alpha]", " ", 
               RowBox[{"(", 
                RowBox[{"\[Alpha]", "+", 
                 RowBox[{"a", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", "\[Alpha]"}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}], "+", 
                 "\[Eta]", "-", 
                 RowBox[{"2", " ", "\[Alpha]", " ", "\[Eta]"}], "+", 
                 RowBox[{"2", " ", "ks", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", "\[Alpha]", "+", "\[Eta]", "-", 
                    RowBox[{"\[Alpha]", " ", "\[Eta]"}]}], ")"}]}]}], 
                ")"}]}]}], ")"}]}]}], ")"}]}]}], ")"}]}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["c", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "c"}], ")"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "4"]}], "-", 
     RowBox[{"2", " ", "c", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "c"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"a", " ", "c"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "c"}]}], ")"}], " ", "kr"}]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"], " ", "\[Alpha]"}], "+", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"4", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"3", "+", "a"}], ")"}], " ", "c"}]}], ")"}]}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"a", "-", "c", "+", 
              RowBox[{"2", " ", "a", " ", "c"}]}], ")"}], " ", "kr"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "+", 
              RowBox[{"3", " ", "c"}]}], ")"}], " ", 
            SuperscriptBox["kr", "2"]}]}], ")"}]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "c"}], ")"}], "2"], " ", "kr", " ", "ks"}]}], 
       ")"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
      SuperscriptBox["\[Alpha]", "2"]}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", "c", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "a", "-", "kr"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "c"}], ")"}], " ", "kr", " ", "ks"}]}], ")"}], 
      " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
      SuperscriptBox["\[Alpha]", "3"]}], "-", 
     RowBox[{"kr", " ", "ks", " ", 
      SuperscriptBox["\[Alpha]", "4"]}]}], ")"}]}]}]], "Input",
