                RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}], " ", 
              "\[Eta]"}]}], ")"}]}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"n", " ", 
          RowBox[{"(", 
