Cell[TextData[{
 "The condition T_{U_{ns}(k-1)} = ",
 Cell[BoxData[
  StyleBox[
   FractionBox[
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "k"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "k"}], ")"}]}], "+", 
     RowBox[{"b", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"8", "-", 
           RowBox[{"3", " ", "k"}]}], ")"}], " ", "k"}], "+", "n", "+", 
        RowBox[{"k", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "5"}], "+", 
           RowBox[{"2", " ", "k"}]}], ")"}], " ", "n"}], "+", 
        SuperscriptBox["n", "2"]}], ")"}]}]}], 
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "+", "k"}], ")"}], " ", "k"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "n"}]}], ")"}]}]],
   FontSize->24]],ExpressionUUID->"b9417390-62c4-4bb9-a9b0-8ccd818c2310"],
 " > b/c is equivalent to  "
}], "Text",
 CellChangeTimes->{{3.915578893410348*^9, 3.915578939908866*^9}, {
  3.915580855379047*^9, 3.915580862308654*^9}, {3.915582277702506*^9, 
