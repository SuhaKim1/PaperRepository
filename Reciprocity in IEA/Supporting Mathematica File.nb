Cell[BoxData[
 RowBox[{
  RowBox[{"qnc", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "\[Alpha]_", ",", "\[Eta]_"}], 
   "]"}], ":=", 
