            ")"}]}], "+", 
          RowBox[{"kr", " ", "ks", " ", 
           SuperscriptBox["\[Alpha]", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "c"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", "\[Alpha]"}], 
            ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"n", "+", "\[Alpha]"}], ")"}]}], "-", 
          RowBox[{"c", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "n"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"1", "+", "c"}], ")"}]}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "a", "-", "kr"}], ")"}], " ", 
              "\[Alpha]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"c", " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "c"}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"]}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"2", "+", 
                RowBox[{"c", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "a", "-", 
                   RowBox[{"3", " ", "kr"}]}], ")"}]}], "-", 
                RowBox[{"2", " ", "kr"}]}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "\[Alpha]"}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", 
              SuperscriptBox["\[Alpha]", "2"]}]}], ")"}]}]}], ")"}]}], 
       ")"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"b", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", "c"}], ")"}], "2"], " ", 
            RowBox[{"(", 
             RowBox[{"kr", "+", "ks"}], ")"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "c"}], ")"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "ks"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"kr", "+", "ks"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"ks", "+", 
                 RowBox[{"c", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "3"}], "-", "kr", "+", "ks"}], ")"}]}]}], 
                ")"}]}], "+", 
              RowBox[{"a", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{"c", " ", 
