Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"qss", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "c"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", "\[Alpha]"}], ")"}], 
      " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"b", " ", 
         RowBox[{"(", 
          RowBox[{"kr", "+", "ks"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
        RowBox[{"kr", " ", "\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "-", "qrs", "+", "\[Eta]"}], ")"}]}]}], 
       ")"}]}], 
     RowBox[{"c", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"c", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", "n", "+", "\[Alpha]",
         "-", 
        RowBox[{"a", " ", "\[Alpha]"}], "+", 
        RowBox[{"kr", " ", "\[Alpha]"}]}], ")"}]}]]}], "}"}], "}"}]], "Output",\

 CellChangeTimes->{3.88573939611403*^9, 3.885741251209774*^9, 
  3.887371659187084*^9, 3.887372162939619*^9, 3.88738514634123*^9, 
