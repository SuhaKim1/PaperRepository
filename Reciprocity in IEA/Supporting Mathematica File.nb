}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "-", 
      RowBox[{"c", " ", "qi"}], "+", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"(", 
