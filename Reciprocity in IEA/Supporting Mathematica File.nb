   RowBox[{"qi", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"b", " ", "c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
