Cell[BoxData[
 RowBox[{
  RowBox[{"derUsqnalpha", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "k_", ",", "\[Alpha]_", ",", "\[Eta]_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"b", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "k"}], "+", "n"}], ")"}]}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "k"}], "+", "n"}], ")"}], " ", "\[Alpha]", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"qs", "[", 
          RowBox[{
          "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}],
           "]"}], "-", "\[Eta]"}], ")"}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "n"}]]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}]}], " ", "\[Eta]"}], "+", 
       FractionBox[
        RowBox[{"k", " ", "\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"b", " ", "n"}], "+", "\[Alpha]", "+", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"2", " ", "\[Eta]"}]}], ")"}]}], "-", 
           RowBox[{"2", " ", "\[Alpha]", " ", "\[Eta]"}], "+", 
           RowBox[{"c", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "k", "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}], " ", 
               "\[Eta]"}]}], ")"}]}]}], ")"}]}], 
        RowBox[{
         RowBox[{
          SuperscriptBox["c", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
         RowBox[{"c", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}], " ", 
          "\[Alpha]"}], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Alpha]", "2"]}]}]], "-", 
       FractionBox[
        RowBox[{"k", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "c"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}], "-", 
           RowBox[{"4", " ", "\[Alpha]"}]}], ")"}], " ", "\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"b", " ", "c", " ", "k", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
           RowBox[{"b", " ", "n", " ", "\[Alpha]"}], "+", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"(", 
             RowBox[{"\[Alpha]", "-", 
              RowBox[{"2", " ", "\[Alpha]", " ", "\[Eta]"}], "+", 
              RowBox[{"c", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "k", "-", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}], " ", 
                  "\[Eta]"}]}], ")"}]}]}], ")"}]}]}], ")"}]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["c", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
           RowBox[{"c", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}], " ", 
            "\[Alpha]"}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["\[Alpha]", "2"]}]}], ")"}], "2"]], "+", 
       FractionBox[
        RowBox[{"k", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"b", " ", "c", " ", "k", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
