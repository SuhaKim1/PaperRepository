               "\[Eta]"}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["c", "2"], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"]}], "-", 
             RowBox[{"2", " ", 
