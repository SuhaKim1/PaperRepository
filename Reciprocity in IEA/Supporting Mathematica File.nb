Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"qrns", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"b", " ", "c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "ks", "-", "n"}], ")"}], " ", "\[Alpha]"}], "+", 
