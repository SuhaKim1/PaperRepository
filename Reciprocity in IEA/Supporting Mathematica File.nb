Cell[BoxData[
 RowBox[{
  RowBox[{"indusns", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "ks_", ",", " ", "kr_", ",", 
    "\[Alpha]_", ",", "\[Eta]_"}], "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"b", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "-", "a", "-", "ks"}], ")"}], 
        FractionBox["b", "c"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "-", "kr"}], ")"}], 
        RowBox[{"qrnsf", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",", 
          "\[Alpha]", ",", "\[Eta]"}], "]"}]}], "+", 
       RowBox[{"ks", "*", 
        RowBox[{"qss", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",", 
          "\[Alpha]", ",", "\[Eta]"}], "]"}]}], "+", 
       RowBox[{"kr", "*", 
        RowBox[{"qrs", "[", 
