Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"usig", "[", 
        RowBox[{
        "b", ",", "c", ",", "n", ",", "a", ",", "ks", ",", " ", "kr", ",", 
         "\[Alpha]", ",", "\[Eta]", ",", "qss", ",", "qrs"}], "]"}], ",", 
       "qss"}], "]"}], "\[Equal]", "0"}], ",", "qss"}], "]"}], "]"}]], "Input",\

 CellChangeTimes->{{3.885739173514798*^9, 3.8857391744840307`*^9}, {
  3.885739340411971*^9, 3.885739390640958*^9}},
