       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "\[Alpha]", " ", 
       "\[Eta]"}]}], 
     RowBox[{"c", " ", 
      RowBox[{"(", 
