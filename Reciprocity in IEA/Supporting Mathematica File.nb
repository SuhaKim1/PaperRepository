Cell["\<\
We can substitute signatory efforts into qrns (Reciprocal non-signatory \
effort)\
\>", "Text",
 CellChangeTimes->{{3.88590130897773*^9, 3.885901327665708*^9}, {
  3.906085195798126*^9, 3.9060852087130203`*^9}},
