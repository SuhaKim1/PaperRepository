Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"Us", "[", 
     RowBox[{
     "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]", ",", 
      RowBox[{"qs", "[", 
       RowBox[{
       "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
