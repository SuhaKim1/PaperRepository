                RowBox[{"(", 
                 RowBox[{"n", "+", 
                  RowBox[{"k", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}]}], 
                 ")"}]}], "+", 
               RowBox[{"c", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", "k", "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}], " ", 
                   "\[Eta]"}]}], ")"}]}]}], ")"}]}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"c", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              SuperscriptBox["a", "2"]}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"b", "-", "c"}], ")"}], "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
             RowBox[{"a", " ", 
              RowBox[{"(", 
               RowBox[{"b", "-", "c"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}]}], ")"}], 
           "2"]}], ")"}]}], ")"}]}], ")"}]}], "]"}]}]], "Input",
