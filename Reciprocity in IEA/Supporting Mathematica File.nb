Cell[BoxData[
 RowBox[{
  RowBox[{"qrns", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "ks_", ",", " ", "kr_", ",", 
    "\[Alpha]_", ",", "\[Eta]_", ",", "qss_", ",", "qrs_"}], "]"}], ":=", 
