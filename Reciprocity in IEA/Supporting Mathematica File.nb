Cell[BoxData[
 RowBox[{
  RowBox[{"derUnqsa", "[", 
   RowBox[{"b_", ",", "c_", ",", "n_", ",", "k_", ",", "a_", ",", "\[Eta]_"}],
    "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", " ", "k"}], "+", 
      FractionBox[
       RowBox[{"a", " ", "c", " ", "k", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"(", 
           RowBox[{"qn", "[", 
            RowBox[{"b", ",", "c", ",", "n", ",", "k", ",", 
             FractionBox[
              RowBox[{"a", " ", "c"}], 
              RowBox[{"c", "-", "b"}]], ",", "\[Eta]"}], "]"}], ")"}], "-", 
          "\[Eta]"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "b"}], "+", "c"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "-", "c"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox["a", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "b", " ", "n"}], "+", 
               RowBox[{"c", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "+", "k", "-", "n", "-", 
                  RowBox[{"2", " ", "\[Eta]"}]}], ")"}]}]}], ")"}]}], "-", 
            RowBox[{"2", " ", "a", " ", 
             RowBox[{"(", 
              RowBox[{"b", "-", "c"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"c", "+", 
               RowBox[{"2", " ", "b", " ", "k"}], "-", 
               RowBox[{"2", " ", "c", " ", "\[Eta]"}]}], ")"}]}], "+", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"b", "-", "c"}], ")"}], "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", " ", 
                RowBox[{"(", 
                 RowBox[{"n", "+", 
                  RowBox[{"k", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}]}], 
                 ")"}]}], "+", 
               RowBox[{"c", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", "k", "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "2"}], "+", "k", "+", "n"}], ")"}], " ", 
                   "\[Eta]"}]}], ")"}]}]}], ")"}]}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"c", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              SuperscriptBox["a", "2"]}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"b", "-", "c"}], ")"}], "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
             RowBox[{"a", " ", 
              RowBox[{"(", 
               RowBox[{"b", "-", "c"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}]}]}], ")"}], 
           "2"]}], ")"}]}], ")"}]}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.905824247463027*^9, 3.905824262450101*^9}, {
   3.905824299701207*^9, 3.905824332978541*^9}, {3.914546272713685*^9, 
