Cell[CellGroupData[{

Cell["Stability of Grand Coalition with Interior Solution", "Section",
 CellChangeTimes->{{3.905899401672871*^9, 
  3.905899412698483*^9}},ExpressionUUID->"1c4ee29b-401a-48ac-a4a5-\
84df3b591332"],

Cell["\<\
We showed in Proposition 2(5) that we need two conditions satisfied for an \
interior solution so that qi\[CloseCurlyQuote]s are in (0,1).
1. \[Alpha] < min{b/\[Eta]; (c-b)/(1-\[Eta])}
2. k < kbar
Furthermore,  we need to make sure that the parameters we choose satisfy:
1. c > b > 0
2. c > 2\[Alpha]
3. \[Eta] in (0,1]\
\>", "Text",
 CellChangeTimes->{{3.9059028815793037`*^9, 
  3.905902954779828*^9}},ExpressionUUID->"cc5c667c-2a53-4f50-8e5b-\
587eee82a370"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kbar", "[", 
   RowBox[{"b_", ",", "c_", ",", "n_", ",", "\[Alpha]_", ",", "\[Eta]_"}], 
   "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["c", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
     RowBox[{"c", " ", "\[Alpha]", " ", 
      RowBox[{"(", 
       RowBox[{"4", "+", 
        RowBox[{"n", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}], "-", 
        RowBox[{"2", " ", "\[Eta]"}]}], ")"}]}], "+", 
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "b"}], " ", "n"}], "+", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "3"}], "+", 
           RowBox[{"2", " ", "\[Eta]"}]}], ")"}]}]}], ")"}]}]}], 
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "\[Eta]"}], ")"}]}]}], ")"}]}]], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9059030090114613`*^9, 3.905903013370434*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"e0aa7a59-679c-497a-8b33-3ab54a116b77"],

