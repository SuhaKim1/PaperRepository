Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Us", "[", 
   RowBox[{
   "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]", ",", 
    RowBox[{"qs", "[", 
     RowBox[{
     "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
     "]"}], ",", 
    RowBox[{"qn", "[", 
     RowBox[{
     "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
     "]"}]}], "]"}], "]"}]], "Input",
 FontFamily->"Courier",
 FontWeight->"Regular",
 CellLabel->"In[22]:=",ExpressionUUID->"7de817f4-1763-4f05-abdb-d6736b82f1e1"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "k", "-", "n"}], ")"}], " ", "\[Alpha]"}]}], ")"}], 
    " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["c", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "+", "k", "+", "n"}], ")"}], " ", "\[Alpha]"}], 
      "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Alpha]", "2"]}]}], ")"}]}]], 
  RowBox[{"(", 
