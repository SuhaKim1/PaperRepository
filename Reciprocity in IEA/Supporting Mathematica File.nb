    RowBox[{
     FractionBox[
      RowBox[{
       FractionBox[
        RowBox[{"b", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "a"}], "+", "n"}], ")"}]}], "c"], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", "qj"}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "n"}]], "-", "\[Eta]"}], ")"}]}]}]], "Output",\

 CellChangeTimes->{3.9059907666654167`*^9},
