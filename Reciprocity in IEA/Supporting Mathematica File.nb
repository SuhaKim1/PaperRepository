               RowBox[{"-", "a"}], "-", "ks", "+", "n"}], ")"}]}], "c"], "+", 
           
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "-", "kr", "-", "1"}], ")"}], " ", "qrns"}], "+", 
           RowBox[{"kr", " ", "qrs"}], "+", 
