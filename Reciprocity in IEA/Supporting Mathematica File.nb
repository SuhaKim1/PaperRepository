Cell["\<\
The partial derivative of non-signatory indirect utility wrt qs (qn at \
optimal) times the partial derivative of signatory effort wrt alpha\
\>", "Text",
 CellChangeTimes->{
  3.905823887485951*^9, {3.9058240856555758`*^9, 3.9058240896127234`*^9}, {
