        RowBox[{
         RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "\[Alpha]"}], "+", 
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{"9", "-", 
         RowBox[{"4", " ", "n"}]}], ")"}], " ", 
       SuperscriptBox["\[Alpha]", "2"]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Alpha]", "3"]}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{"c", "-", 
          RowBox[{"c", " ", "n"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "\[Alpha]"}]}], 
         ")"}]}], "+", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"(", 
         RowBox[{"\[Alpha]", "+", 
          RowBox[{"c", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}]}]}], ")"}]}]}], ")"}],
      "2"]}], 
   RowBox[{"2", " ", "c", " ", 
    RowBox[{"(", 
     RowBox[{"c", "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["c", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
       RowBox[{"2", " ", "c", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "\[Alpha]"}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[Alpha]", "2"]}]}], ")"}], "2"]}]]}]], "Output",
 CellChangeTimes->{3.905903108115158*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"5d64835d-4902-4389-a207-41e0c4d459a8"]
}, Open  ]],

Cell["\<\
Notice that there are two terms multiplied in the numerator. The second one \
is positive given that it is the squared. The denominator is positive since \
c>0, c>2\[Alpha], and the squared term.
Thus, for this condition to hold, we need the first term in the numerator to \
be negative given that there is a minus in front of the whole term.\
\>", "Text",
 CellChangeTimes->{{3.905903178580632*^9, 
  3.90590321293653*^9}},ExpressionUUID->"45f86eef-c746-4915-b9ae-\
dae83090bd24"],

Cell[BoxData[
 RowBox[{
  RowBox[{"term1", "[", 
   RowBox[{"c_", ",", "n_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    SuperscriptBox["c", "3"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "3"}], "+", "n"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["c", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "3"}], "+", "n"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "\[Alpha]"}], "+", 
   RowBox[{"c", " ", 
    RowBox[{"(", 
     RowBox[{"9", "-", 
      RowBox[{"4", " ", "n"}]}], ")"}], " ", 
    SuperscriptBox["\[Alpha]", "2"]}], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Alpha]", "3"]}]}]}]], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"4db21500-7cb2-4f92-abdc-7d5fdf231a38"],

Cell["\<\
There are 4 terms in term1. 
The first: it is always positive for n > 3; (zero for n = 1 or n = 3; \
negative for n = 2.) c amplifies the magnitude of this term.
The second:  it is negative for n > 3. c and \[Alpha] amplify the magnitude \
of this term.
The third: it is negative for n \[GreaterEqual] 3. c and \[Alpha] amplify the \
magnitude of this term.
The fourth: it is always negative. \[Alpha] amplifies the magnitude of this \
term.
Thus, alpha always decreases term1 for n > 3. So, we should choose high alpha\
\[CloseCurlyQuote]s.\
\>", "Text",
 CellChangeTimes->{{3.905903294977091*^9, 3.90590332632411*^9}, {
  3.905903358184925*^9, 
  3.905903363409639*^9}},ExpressionUUID->"04b0a740-2004-4046-ad24-\
c3257117db8b"],

Cell[TextData[{
 StyleBox["Strategy",
  FontWeight->"Bold"],
 ": search for parameter values such that term1 is negative as desired. Then, \
check whether the parameter values that satisfy term1<0 also satisfy interior \
solution."
}], "Text",
 CellChangeTimes->{
  3.905903455514996*^9},ExpressionUUID->"504b92ae-8ddb-41fb-b56f-\
3d96d3b132bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"term1", "[", 
       RowBox[{"c", ",", "n", ",", "0.06"}], "]"}], "*", 
      RowBox[{"1", "/", "1000"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "4", ",", "20"}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0.1", ",", "10"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"fc3e4c04-fb55-4c32-b708-fbad6009e081"],

