Cell["Using symmetry and solving for qrns yields the result:", "Text",
 CellChangeTimes->{{3.885735361441725*^9, 3.8857353760953712`*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"0c62c1f3-8782-42c5-b85b-921d872df247"],

