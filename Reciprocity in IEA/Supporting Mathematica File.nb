Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Us", "[", 
       RowBox[{
       "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]", ",", 
