Cell["\<\
The level of reciprocal concern \[Alpha] needed for the reciprocal countries \
to exert full effort:\
\>", "Text",
 CellChangeTimes->{{3.9059909890094233`*^9, 3.90599100835989*^9}, {
  3.905991147337887*^9, 
  3.905991147534169*^9}},ExpressionUUID->"edfd4fcc-cbb5-4055-b396-\
a368108eba11"],

Cell[CellGroupData[{

