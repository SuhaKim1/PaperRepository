Cell[CellGroupData[{

Cell["Heterogeneity: Self-Interested and Reciprocal Countries", "Section",
 CellChangeTimes->{{3.905990076179335*^9, 3.905990083896616*^9}, {
  3.906083440741189*^9, 3.906083444948234*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"2f9b2942-88c1-4ef8-a9bd-4450d64e4986"],

Cell["\<\
There are A<N reciprocal countries with \[Alpha]_i = \[Alpha] and N-A \
self-interested countries with \[Alpha]_i = 0. With abuse of notation, we \
avoid using the capital letter \[OpenCurlyDoubleQuote]A\
\[CloseCurlyDoubleQuote] and instead use the lower case letter \
\[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote]. This \
\[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote] is different than the one \
that capture how much a country care about reciprocity in comparison to \
material payoffs. In this section, we only use \[Alpha]\
\>", "Text",
 CellChangeTimes->{
  3.905990722928595*^9, {3.920428175324836*^9, 3.920428309241619*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"4caa9c8d-99e0-4983-876b-52bbe3e97769"],

Cell[CellGroupData[{

Cell["Non-Cooperative Game - Proposition 5", "Subsection",
 CellChangeTimes->{
  3.905990732525214*^9, {3.905992407864274*^9, 3.905992411756193*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"5e4b897e-2ff1-421b-8fa8-4b1182da44fa"],

Cell["\<\
Self-interested countries have a dominant strategy to exert b/c. Let\
\[CloseCurlyQuote]s find out about the reciprocal Nash efforts. To do that, \
let\[CloseCurlyQuote]s write the utility function.\
\>", "Text",
 CellChangeTimes->{3.9059907389178343`*^9},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"82469d8f-943a-400b-bbd0-ecc8bb1b1c95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ui", "[", 
   RowBox[{
   "b_", ",", "c_", ",", "n_", ",", "a_", ",", "\[Alpha]_", ",", "\[Eta]_", 
    ",", "qi_", ",", "qj_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"b", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "a"}], ")"}], 
       FractionBox["b", "c"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}], "qj"}], "+", "qi"}], ")"}]}], "-", 
   RowBox[{
    FractionBox["c", "2"], 
    SuperscriptBox["qi", "2"]}], "+", 
   RowBox[{"\[Alpha]", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "-", "a"}], ")"}], 
         FractionBox["b", "c"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "-", "1"}], ")"}], "qj"}]}], 
       RowBox[{"n", "-", "1"}]], "-", "\[Eta]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"qi", "+", "1", "-", "\[Eta]"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{3.905990750733724*^9},
 FontFamily->"Courier",
 FontWeight->"Regular",
 CellLabel->
  "In[132]:=",ExpressionUUID->"3d973aa7-417f-4877-9e70-536686622412"],

Cell["\<\
Taking derivative wrt qi and solving for qi yields the Nash efforts of the \
reciprocal countries:\
\>", "Text",
 CellChangeTimes->{{3.9059907589703093`*^9, 3.905990807264606*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"d80b078c-ca1d-4295-9a26-38a789bb6337"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"ui", "[", 
    RowBox[{
    "b", ",", "c", ",", "n", ",", "a", ",", "\[Alpha]", ",", "\[Eta]", ",", 
     "qi", ",", "qj"}], "]"}], ",", "qi"}], "]"}]], "Input",
 FontFamily->"Courier",
 FontWeight->"Regular",
 CellLabel->
  "In[133]:=",ExpressionUUID->"22df2c82-0e92-4e04-8efb-98099498619f"],

Cell[BoxData[
 RowBox[{"b", "-", 
  RowBox[{"c", " ", "qi"}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       FractionBox[
        RowBox[{"b", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "a"}], "+", "n"}], ")"}]}], "c"], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", "qj"}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "n"}]], "-", "\[Eta]"}], ")"}]}]}]], "Output",\

 CellChangeTimes->{3.9059907666654167`*^9, 3.914276590898513*^9, 
  3.9144632684171658`*^9, 3.914539389078047*^9, 3.915566471764058*^9, 
  3.915571967800191*^9, 3.919811202135763*^9, 3.920326823271145*^9, 
