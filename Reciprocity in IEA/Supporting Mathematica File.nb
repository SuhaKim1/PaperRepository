 FontWeight->"Regular",
 CellLabel->
  "In[144]:=",ExpressionUUID->"d17489b6-7b66-4f1b-9939-593794637313"],

Cell["\<\
Take first derivative wrt qss (FOC) and solving for qss (self-interested \
signatory effort); and then similarly with qrs (reciprocal signatory effort).\
\
\>", "Text",
 CellChangeTimes->{{3.885739130524547*^9, 3.8857391684989967`*^9}, {
  3.885739405526462*^9, 3.885739413357994*^9}, {3.906084967500663*^9, 
