              RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", "qi"}]}], 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}]], "-", "\[Eta]"}], ")"}]}]}], "==", 
     "0"}], ",", "qi"}], "]"}], "]"}]], "Input",
 CellLabel->
