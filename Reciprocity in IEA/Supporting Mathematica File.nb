 CellLabel->
  "In[191]:=",ExpressionUUID->"2f56767a-7a06-4603-a02c-5ddc8c902c44"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"qrns", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"b", " ", "c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "ks", "-", "n"}], ")"}], " ", "\[Alpha]"}], "+", 
      RowBox[{"c", " ", "\[Alpha]", " ", 
