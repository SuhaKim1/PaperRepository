Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Us", "[", 
       RowBox[{
       "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]", ",", 
        RowBox[{"qs", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
         "]"}], ",", 
        RowBox[{"qn", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
         "]"}]}], "]"}], "-", 
      RowBox[{"Un", "[", 
       RowBox[{
       "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]", ",", 
        RowBox[{"qs", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
         "]"}], ",", 
        RowBox[{"qn", "[", 
         RowBox[{
         "b", ",", "c", ",", "n", ",", "k", ",", "\[Alpha]", ",", "\[Eta]"}], 
         "]"}]}], "]"}]}], "==", "0"}], ",", "k"}], "]"}], "]"}]], "Input",
 FontFamily->"Courier",
 FontWeight->"Regular",
 CellLabel->"In[30]:=",ExpressionUUID->"110e72b8-9cfe-4d61-9c7e-c23b60810e84"],

