 CellLabel->"Out[77]=",ExpressionUUID->"7ef740ba-3d95-4c08-a185-f7aefa61c3fb"]
}, Open  ]],

Cell[TextData[{
 "We solved for \[Eta] in the paper and find that coalition size contracts at \
\[Eta] < (2N+4)/N^2 under small alpha assumption.\nWe call this threshold \
T_2, since the coalition size contracts to 2. \n\n",
 StyleBox["T_2 > T_{U_{ns}(k-1)}",
  FontFamily->"Source Code Pro",
  FontSize->12.78,
  FontWeight->"Bold"],
 " if \n",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"2", "n"}], "+", "4"}], 
    RowBox[{"n", "^", "2"}]], ">", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "k"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "k"}], ")"}]}], "+", 
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "4"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"8", "-", 
            RowBox[{"3", " ", "k"}]}], ")"}], " ", "k"}], "+", "n", "+", 
         RowBox[{"k", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "5"}], "+", 
            RowBox[{"2", " ", "k"}]}], ")"}], " ", "n"}], "+", 
         SuperscriptBox["n", "2"]}], ")"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"c", " ", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "3"}], "+", "k"}], ")"}], " ", "k"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "n"}]}], ")"}]}], 
     ")"}]}]}]],ExpressionUUID->"b5e46ec9-a19b-4ef7-a306-c3f797628835"],
 "\nGetting rid of the b and c as usual using bn/c = 1, we get the \
following:"
}], "Text",
 CellChangeTimes->{{3.91573831158782*^9, 3.915738472074017*^9}, {
  3.915738531971705*^9, 3.915738532260234*^9}, {3.9157387569388933`*^9, 
  3.915738789214672*^9}, {3.9182953862881823`*^9, 3.918295415163574*^9}, {
  3.9184349373126087`*^9, 3.918434942205615*^9}, {3.9185259811018877`*^9, 
  3.918525996422372*^9}},
 FontFamily->"Courier",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"8f7e6e40-4c6c-4eda-b604-118cfdaa368f"],

