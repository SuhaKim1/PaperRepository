           RowBox[{"c", "-", "\[Alpha]"}], ")"}], " ", "\[Alpha]"}]}], 
        ")"}]}], "+", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["c", "3"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "-", 
         RowBox[{
          SuperscriptBox["c", "2"], " ", "\[Alpha]"}], "+", 
         SuperscriptBox["\[Alpha]", "3"]}], ")"}], " ", "\[Eta]"}]}], 
     SuperscriptBox["\[Alpha]", "4"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.905981854530402*^9},
 CellLabel->
  "Out[174]=",ExpressionUUID->"7b818661-6df5-446f-9ac3-a14108967663"]
}, Open  ]],

